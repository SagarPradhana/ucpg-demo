# Quick Fix: Use Netlify Proxy (Copy to .env.production if backend CORS fix doesn't work)
VITE_API_BASE_URL=/api
VITE_USE_API_PROXY=true
VITE_ENVIRONMENT=production

# Instructions:
# 1. If your backend CORS is fixed, use the regular .env.production
# 2. If you need a quick fix, copy these values to .env.production
# 3. This will route API calls through Netlify proxy to your Render backend